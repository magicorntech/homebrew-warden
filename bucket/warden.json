    "version":  "0.9.1",
    "description":  "Warden: identity-native infrastructure access. The tray app and the warden command-line client.",
    "homepage":  "https://github.com/magicorntech/homebrew-warden",
    "license":  "Proprietary",
    "architecture":  {
                         "64bit":  {
                                       "hash":  "bb1055ecbc6ef62976112acf160146e1b773b92660458056955b942d2deab0e0",
                                       "url":  "https://github.com/magicorntech/homebrew-warden/releases/download/v0.9.1/Warden-0.9.1-x64-portable.zip"
                                   }
                     },
    "bin":  "warden.exe",
    "shortcuts":  [
                      [
                          "WardenApp.exe",
                          "Warden"
                      ]
                  ],
    "post_install":  [
                         "Get-Process WardenApp -ErrorAction SilentlyContinue | Stop-Process -Force",
                         "\u0026 \"$dir\\warden.exe\" daemon stop 2\u003e$null",
                         "\u0026 \"$dir\\warden.exe\" daemon install"
                     ],
    "pre_uninstall":  [
                          "Get-Process WardenApp -ErrorAction SilentlyContinue | Stop-Process -Force",
                          "\u0026 \"$dir\\warden.exe\" daemon uninstall"
                      ],
    "notes":  "Sign in with: warden login --cluster \u003cname\u003e --addr \u003cyour Warden login address\u003e"
}
